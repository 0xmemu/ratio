# Sepolia Testnet Configuration for Execution Engine
# This file is used for Milestone 2 testnet deployment

# Network Configuration
NETWORK=sepolia
CHAIN_ID=11155111

# RPC Configuration
# Use public RPC or your own Infura/Alchemy endpoint
RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
# Fallback RPC endpoints
RPC_FALLBACK_1=https://rpc.sepolia.org
RPC_FALLBACK_2=https://ethereum-sepolia.publicnode.com

# Wallet Configuration
# CRITICAL: Never commit actual private keys to version control
# Use environment variables or secrets management
WALLET_PRIVATE_KEY=your_testnet_private_key_here
WALLET_MIN_BALANCE=0.1  # Minimum balance in ETH (testnet)

# Gas Configuration
MAX_GAS_PRICE=50000000000  # 50 gwei (testnet typically cheaper)
GAS_LIMIT_BUFFER=1.2       # 20% buffer for gas limit estimation
PRIORITY_FEE_MULTIPLIER=1.1

# Validation Configuration
MAX_SLIPPAGE=0.05                    # 5% maximum slippage
MAX_POSITION_SIZE=1000000000000000000  # 1 ETH max position
MIN_GAS_BALANCE=100000000000000000    # 0.1 ETH minimum

# Safety Limits
MAX_DAILY_GAS_SPEND=500000000000000000  # 0.5 ETH daily gas budget
MAX_DAILY_TX_COUNT=50                    # Maximum transactions per day
APPROVAL_THRESHOLD_USD=5000              # Require manual approval above this

# Approval Configuration (Telegram)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_APPROVAL_CHAT_ID=your_chat_id_here
APPROVAL_TIMEOUT_SECONDS=3600  # 1 hour timeout for approvals

# Uniswap v3 Contract Addresses (Sepolia)
UNISWAP_V3_FACTORY=0x0227628f3F023bb0B980b67D528571c95c6DaC1c
UNISWAP_V3_ROUTER=0x3bFA4769FB09eefC5a80d6E87c3B9C650f7Ae48E
UNISWAP_V3_NFT_MANAGER=0x1238536071E1c677A632429e3655c799b22cDA52
UNISWAP_V3_QUOTER=0xEd1f6473345F45b75F8179591dd5bA1888cf2FB3

# Monitoring & Logging
LOG_LEVEL=debug
ENABLE_METRICS=true
METRICS_PORT=9090

# Execution Mode
EXECUTION_MODE=dry_run  # Start with dry-run for safety
# Set to 'live' only after thorough testing
# EXECUTION_MODE=live

# Rollback Configuration
MAX_RETRIES=3
BACKOFF_MULTIPLIER=2
INITIAL_DELAY_MS=1000

# Testing Configuration
ENABLE_TESTNET_FAUCET_CHECK=true
AUTO_REQUEST_TESTNET_ETH=false
